{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)/.claude/venv/bin/python\" \"$(git rev-parse --show-toplevel)/.claude/scripts/hooks/commit_gate.py\"", "timeout": 30000 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)/.claude/venv/bin/python\" \"$(git rev-parse --show-toplevel)/.claude/scripts/hooks/session_gate.py\"", "timeout": 5000 }
        ]
      }
    ]
  }
}
